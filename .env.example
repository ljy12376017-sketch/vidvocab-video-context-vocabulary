# ============================================================
# VidVocab environment variables
# Copy to .env.local and replace PLACEHOLDERS with real values.
# Never commit real secrets. Never add a SERVICE_ROLE key.
# ============================================================

# --- Server-only (DO NOT prefix with NEXT_PUBLIC_) ---
# Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key

# Get from: Google Cloud Console → enable YouTube Data API v3 → create API key
YOUTUBE_API_KEY=your_youtube_data_api_key

# Transcript provider: youtube-unofficial | filmot (stub)
TRANSCRIPT_PROVIDER=youtube-unofficial

# Optional: local HTTP proxy for YouTube/Google (auto-detects 7897/7890 if unset)
# Example: http://127.0.0.1:7897
YOUTUBE_HTTPS_PROXY=

# --- Public (safe with RLS; still rotate if leaked) ---
# Get from: Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
